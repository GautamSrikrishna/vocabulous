# ---------------------------------------------------------------
# Vocabulous — Sarvam AI credentials
#
# 1. Copy this file to `.env`      cp .env.example .env
# 2. Paste your key below (get one at https://dashboard.sarvam.ai)
# 3. Restart the dev server
#
# NOTE: none of these are prefixed NEXT_PUBLIC_, on purpose.
# That is what keeps the key on the server and out of the browser.
# ---------------------------------------------------------------

SARVAM_API_KEY=sk_replace_me

# Model choices — the defaults are good, override only if you want to.
SARVAM_CHAT_MODEL=sarvam-105b-conversations
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3

# Voice used for the "hear it" buttons. Must be lowercase.
# Female voices for bulbul:v3: ritu, priya, neha, pooja, kavya, shreya
# Male voices:                 shubh, aditya, ashutosh, rahul, dev
# (anushka and the other bulbul:v2 voices are NOT valid for v3.)
SARVAM_TTS_SPEAKER=ritu
