# ---------------------------------------------------------------
# Vocabulous — Sarvam AI credentials
#
# 1. Copy this file to `.env`      cp .env.example .env
# 2. Paste your key below (get one at https://dashboard.sarvam.ai)
# 3. Restart the dev server
#
# NOTE: none of these are prefixed NEXT_PUBLIC_, on purpose.
# That is what keeps the key on the server and out of the browser.
# ---------------------------------------------------------------

SARVAM_API_KEY=sk_replace_me

# Model choices — the defaults are good, override only if you want to.
SARVAM_CHAT_MODEL=sarvam-105b-conversations
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash

# Voices used for the "hear it" buttons, one per answer language. Must be lowercase.
# bulbul:v4-flash voices are per-language persona IDs: <name>_<lang>_<style>.
# Kannada: chaitra_kn_narration, chaitra_kn_conversation, suchitra_kn_narration,
#          chetan_kn_conversation
# English: nupur_en_kids is the only one tagged for kids; full list at
#          https://docs.sarvam.ai/api/api-guides-tutorials/text-to-speech/voices
# (bulbul:v3 short names like shreya or shubh are NOT valid for v4-flash.)
SARVAM_TTS_SPEAKER_EN=nupur_en_kids
SARVAM_TTS_SPEAKER_KN=chaitra_kn_narration
